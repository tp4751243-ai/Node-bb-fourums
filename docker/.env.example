# Copy to docker/.env and fill in. Never commit .env (it is git-ignored).

# --- Site ---
DOMAIN=forum.example.com
NODEBB_URL=https://forum.example.com

# --- First administrator: used once by the setup step. Delete the password line afterwards. ---
NODEBB_ADMIN_USERNAME=admin
NODEBB_ADMIN_EMAIL=you@example.com
NODEBB_ADMIN_PASSWORD=

# --- Supabase database ---
# Supabase dashboard > Connect > "Session pooler" (port 5432).
# Do NOT use the transaction pooler (port 6543): NodeBB uses prepared statements, which it breaks.
NODEBB_DB_HOST=aws-0-eu-central-1.pooler.supabase.com
NODEBB_DB_PORT=5432
# The dedicated role from supabase/01-nodebb-role.sql, written as <role>.<project-ref>
NODEBB_DB_USER=nodebb.your-project-ref
NODEBB_DB_PASSWORD=
NODEBB_DB_NAME=postgres
